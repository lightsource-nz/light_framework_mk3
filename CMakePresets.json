{
    "version": 6,
    "include": [
        "cmake/light_presets/light_presets.json",
        "cmake/light_presets/light_pico_presets.json"
    ],
    "configurePresets": [
        {
            "name": "conf-demo-cli-base",
            "hidden": true,
            "inherits": ["conf-light-host-base"],
            "binaryDir": "${sourceDir}/build",
            "generator": "Ninja"
        },
        {
            "name": "conf-demo-cli-debug",
            "inherits": [
                "conf-demo-cli-base",
                "conf-light-debug"
            ]
        },
        {
            "name": "conf-demo-cli-trace",
            "inherits": [
                "conf-demo-cli-base",
                "conf-light-trace"
            ]
        },
        {
            "name": "conf-demo-cli-release",
            "inherits": [
                "conf-demo-cli-base",
                "conf-light-release"
            ]
        },
        {
            "name": "conf-demo-blackpill-debug",
            "description": "WeAct Blackpill (STM32F411CEU6) on bare CMSIS. Own binaryDir, as with screen-test's mini-stm32h7 preset: the arm-none-eabi toolchain is found on PATH by cmake/toolchain/arm_none_eabi.cmake, which light_cmsis_select_toolchain() selects before project(); set LIGHT_TOOLCHAIN_PATH if more than one is installed.",
            "inherits": [
                "conf-light-base",
                "conf-light-debug"
            ],
            "binaryDir": "${sourceDir}/build-blackpill",
            "generator": "Ninja",
            "cacheVariables": {
                "LIGHT_SYSTEM": "CMSIS",
                "LIGHT_PLATFORM": "TARGET",
                "LIGHT_BOARD": "blackpill"
            }
        },
        {
            "name": "conf-demo-mini-stm32h7-debug",
            "description": "WeAct MiniSTM32H7xx (STM32H743VIT6) on bare CMSIS. See conf-demo-blackpill-debug for the toolchain note.",
            "inherits": [
                "conf-light-base",
                "conf-light-debug"
            ],
            "binaryDir": "${sourceDir}/build-mini-stm32h7",
            "generator": "Ninja",
            "cacheVariables": {
                "LIGHT_SYSTEM": "CMSIS",
                "LIGHT_PLATFORM": "TARGET",
                "LIGHT_BOARD": "mini_stm32h7"
            }
        },
        {
            "name": "conf-demo-bluepill-plus-debug",
            "description": "WeAct BluePill+ (STM32F103C8T6) on bare CMSIS. See conf-demo-blackpill-debug for the toolchain note.",
            "inherits": [
                "conf-light-base",
                "conf-light-debug"
            ],
            "binaryDir": "${sourceDir}/build-bluepill-plus",
            "generator": "Ninja",
            "cacheVariables": {
                "LIGHT_SYSTEM": "CMSIS",
                "LIGHT_PLATFORM": "TARGET",
                "LIGHT_BOARD": "bluepill_plus"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build-demo-cli-debug",
            "configurePreset": "conf-demo-cli-debug",
            "targets": ["demo_cli"]
        },
        {
            "name": "build-demo-cli-trace",
            "configurePreset": "conf-demo-cli-trace",
            "targets": ["demo_cli"]
        },
        {
            "name": "build-demo-cli-release",
            "configurePreset": "conf-demo-cli-release",
            "targets": ["demo_cli"]
        },
        {
            "name": "build-demo-blackpill-debug",
            "configurePreset": "conf-demo-blackpill-debug",
            "targets": ["demo_blackpill"]
        },
        {
            "name": "build-demo-mini-stm32h7-debug",
            "configurePreset": "conf-demo-mini-stm32h7-debug",
            "targets": ["demo_mini_stm32h7"]
        },
        {
            "name": "build-demo-bluepill-plus-debug",
            "configurePreset": "conf-demo-bluepill-plus-debug",
            "targets": ["demo_bluepill_plus"]
        }
    ]
}