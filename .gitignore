.vscode/*.log
.vscode/.cortex-debug.*
build/
# board-specific trees alongside the default one, e.g. build-pico-hostmode: the pico_hostmode
# port has its own copy of light_object.c, so testing it needs a second configure rather than
# a second target in the same tree
build-*/
stage/
CMakeUserPresets.json
# machine-specific tool and dependency paths -- see user.config.example.ps1.
# This is the ONE place an absolute path may live, and it must never be committed.
user.config.ps1
